# Project-local Docker isolation profile. Copy to ops/compose/mairs.env.
# Values are only loaded for the docker-stack.ps1 process and are not persisted
# in your user or system environment.
COMPOSE_PROJECT_NAME=mairs

# Dedicated host-port range for this project. Container ports remain unchanged.
MAIRS_FRONTEND_PORT=15173
MAIRS_BACKEND_PORT=18000
MAIRS_POSTGRES_PORT=15432
MAIRS_REDIS_PORT=16379
MAIRS_PROMETHEUS_PORT=19090
MAIRS_ALERTMANAGER_PORT=19093
MAIRS_GRAFANA_PORT=13000
