POSTGRES_DB=incident_response
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password
REDIS_PASSWORD=replace-with-strong-redis-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_PRIVACY_MODE=strict

APP_CORS_ORIGINS=https://app.example.com
APP_ALLOWED_HOSTS=api.example.com,app.example.com
APP_OPERATIONS_MODE=production
APP_ADMIN_API_TOKEN=replace-with-strong-admin-token
APP_API_KEY_PEPPER=replace-with-strong-api-key-pepper
APP_DATABASE_URL=postgresql+asyncpg://incident_user:replace-with-strong-postgres-password@postgres:5432/incident_response
APP_AUTO_CREATE_SCHEMA=false
APP_REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
APP_QUEUE_NAME=incident-response:jobs
APP_DELAYED_QUEUE_NAME=incident-response:jobs:delayed
APP_DLQ_NAME=incident-response:jobs:dlq
APP_RUN_LOCK_PREFIX=incident-response:lock
APP_RUN_LOCK_TTL_SECONDS=900
APP_JOB_MAX_RETRIES=3
APP_JOB_RETRY_DELAY_SECONDS=30
APP_WORKER_POLL_SECONDS=5
APP_MAX_REQUEST_BODY_BYTES=1000000
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS=300
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_TRUST_PROXY_HEADERS=true
DEMO_API_TOKEN=
VITE_API_TOKEN=
VITE_RELEASE_APPROVAL_ID=
